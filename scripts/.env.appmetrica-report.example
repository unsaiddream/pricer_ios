# AppMetrica numeric app id. For current project it is visible in the AppMetrica URL as appId=6296656.
APPMETRICA_APP_ID=6296656
APPMETRICA_OAUTH_TOKEN=put_yandex_oauth_token_here

# Telegram bot created via @BotFather.
TELEGRAM_BOT_TOKEN=put_telegram_bot_token_here
TELEGRAM_CHAT_ID=put_chat_or_channel_id_here

# By default the script sends yesterday's report; this is safer because AppMetrica data may lag.
REPORT_DATE=yesterday
REPORT_TIMEZONE=Asia/Almaty
REPORT_OUTPUT=build/appmetrica_report.png
APPMETRICA_LOG_LIMIT=10000
